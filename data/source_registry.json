{
  "version": 1,
  "policy": "Store provider provenance and metadata rights separately from the rights governing each linked website or document. Do not infer a content license from the provider's metadata license.",
  "providers": [
    {
      "id": "curlie",
      "name": "Curlie",
      "kind": "curated web directory",
      "endpoint": "https://www.curlie.org/docs/en/rdf.html",
      "metadata_license": "CC BY 3.0",
      "attribution_required": true,
      "redistribution": "allowed_with_attribution",
      "required_record_fields": [
        "source",
        "source_id",
        "source_license",
        "source_attribution",
        "source_category_path"
      ],
      "notes": "Attribute Curlie on public pages containing imported records. Attribution does not imply endorsement."
    },
    {
      "id": "openalex-institutions",
      "name": "OpenAlex Institutions API",
      "kind": "research institution metadata",
      "endpoint": "https://api.openalex.org/institutions",
      "documentation": "https://help.openalex.org/api/",
      "metadata_license": "CC0 1.0",
      "attribution_required": false,
      "recommended_attribution": "OpenAlex",
      "redistribution": "allowed_for_metadata",
      "content_license": "unknown_per_institution",
      "required_record_fields": [
        "source",
        "source_id",
        "source_url",
        "source_license",
        "source_attribution",
        "imported_at",
        "content_license"
      ],
      "notes": "Only metadata and official homepage URLs are imported. The linked institution's website content is not relicensed by OpenAlex."
    },
    {
      "id": "crossref",
      "name": "Crossref REST API",
      "kind": "bibliographic metadata",
      "endpoint": "https://api.crossref.org/",
      "documentation": "https://www.crossref.org/documentation/retrieve-metadata/rest-api",
      "metadata_license": "CC0_for_crossref_generated_data_and_factual_metadata",
      "attribution_required": false,
      "redistribution": "metadata_only",
      "content_license": "abstracts_remain_under_publisher_or_author_rights",
      "notes": "Do not bulk-copy abstracts into CAOS. Use Crossref for DOI metadata, journal discovery and provenance."
    },
    {
      "id": "wikidata",
      "name": "Wikidata",
      "kind": "structured knowledge graph",
      "endpoint": "https://www.wikidata.org/wiki/Special:EntityData/",
      "documentation": "https://www.wikidata.org/wiki/Wikidata:Licensing",
      "metadata_license": "CC0 1.0",
      "attribution_required": false,
      "recommended_attribution": "Wikidata",
      "redistribution": "allowed_for_structured_data",
      "content_license": "external_link_targets_have_independent_rights",
      "notes": "Structured data is CC0. Text in other Wikidata namespaces has different licensing; this registry covers structured entity data only."
    },
    {
      "id": "core",
      "name": "CORE",
      "kind": "research discovery and repository API",
      "endpoint": "https://api.core.ac.uk/",
      "documentation": "https://core.ac.uk/terms",
      "metadata_license": "license_required_for_api_and_most_datasets",
      "attribution_required": "depends_on_license",
      "redistribution": "obtain_license_before_product_or_bulk_use",
      "notes": "CORE terms require a licence for the API and other datasets; contact CORE before building a product, search service or redistributable dataset on its data."
    },
    {
      "id": "doaj-journals",
      "name": "Directory of Open Access Journals",
      "kind": "open access scholarly journal directory",
      "endpoint": "https://doaj.org/api/v4/search/journals/",
      "documentation": "https://doaj.org/docs/api/",
      "metadata_license": "CC0 1.0 (journal-level metadata)",
      "attribution_required": false,
      "recommended_attribution": "Directory of Open Access Journals (DOAJ)",
      "redistribution": "allowed_for_journal_level_metadata",
      "content_license": "independent_per_journal_website",
      "required_record_fields": [
        "source",
        "source_id",
        "source_url",
        "source_license",
        "source_attribution",
        "imported_at",
        "content_license"
      ],
      "notes": "Only journal-level metadata and homepage URLs are used. DOAJ metadata CC0 does not relicense the linked journal websites. Public API requests are deliberately rate-limited."
    }
  ]
}
